#!/usr/bin/env bash

# Preserve the parent workspace environment, including its Mold linker flag.
source_up

# Allow submodule-specific environment values.
watch_file .env
if [ -f .env ]; then
	dotenv .env
fi

# Optimize Rust builds for the current machine.
export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C target-cpu=native"
